from synch import *

def Circus() returns circus:
    #circus.entered[i] is whether or not a clown of colors[i] has entered the circus
    circus = {  .entered: [False, False, False],
                .ready: [False,]*3,
                .exiting: False,
                .full: Condition(), 
                .empty: Condition(), 
                .mutex: Lock()
                }

def enter(c, color):
    acquire(?c->mutex)
    while c->ready[color] or c->exiting: # wait for there to be no other clown of same color and clowns to finish exiting
        wait(?c->empty, ?c->mutex)

    c->ready[color] = True # the clown is ready to enter the circus!
    if all(c->ready):                             # all three cols ready now
        c->entered = c->ready
        c->ready = [False,]*3                      # Resetting ready
        c->exiting = True
        notify_all(?c->full)                   # Let clowns start exiting
    else:
        while not c->exiting:                # Wait until group is fully entered
            wait(?c->full, ?c->mutex)

    release(?c->mutex)
    
def exit(c, color):
    acquire(?c->mutex)

    c->entered[color] = False

    if not any(c->entered): #if everything is false
        c->exiting = False
        notify_all(?c->empty)

    release(?c->mutex)